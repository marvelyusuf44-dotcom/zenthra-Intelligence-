# Salin jadi .env (dev lokal) / Environment Variables di Vercel.
# JANGAN commit file .env asli ke Git — cuma file .env.example ini yang boleh masuk repo.
#
# Deploy production sekarang SATU project Vercel buat semuanya (API + dashboard
# + landing, lihat vercel.json di root dan DEPLOY.md) — bukan lagi Railway +
# Vercel terpisah, jadi semua variabel di bawah ini tinggal diisi sekali di
# Vercel env, tidak perlu dipisah per platform.

# --- API server ---
PORT=5000
DATABASE_URL=                     # Postgres connection string (Supabase)
JWT_SECRET=                       # random string panjang, buat sign token login
GEMINI_API_KEY=                   # AI Studio / Gemini API key — otak chat Zenthra
HELIUS_API_KEY=                   # wallet analysis Solana (kosongkan = fitur wallet nonaktif dulu)

# --- Supabase (dipakai services/supabase.ts) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- WhatsApp Cloud API — "Chat with Zenthra" (satu nomor resmi Zenthra) ---
WHATSAPP_VERIFY_TOKEN=            # bebas kamu tentuin sendiri, dipakai saat setup webhook di Meta dashboard
WHATSAPP_ACCESS_TOKEN=            # System User access token dari Meta App
WHATSAPP_PHONE_NUMBER_ID=         # dari WhatsApp Business Platform > phone numbers

# --- WhatsApp Embedded Signup — "Connect your WhatsApp" (nomor milik user sendiri) ---
META_APP_ID=                      # Meta App Dashboard > App settings > Basic
META_APP_SECRET=                  # Meta App Dashboard > App settings > Basic (JANGAN expose ke frontend)
META_CONFIG_ID=                   # Meta App Dashboard > WhatsApp > Embedded Signup > Configuration ID

# --- Frontend ---
# Only needed if you ever split the API to a different origin than the
# dashboard. The normal single-Vercel-domain deploy (zenthra.web.id) is
# same-origin end to end, so leave this blank in production.
VITE_API_BASE_URL=

# --- Admin actions (konfirmasi pembayaran QRIS manual, dsb) ---
ADMIN_API_SECRET=                 # random string panjang, JANGAN pernah dikirim ke frontend

# --- Hardening ---
WA_TOKEN_ENCRYPTION_KEY=          # random string panjang — buat enkripsi access_token di zenthra_wa_connections
ALLOWED_ORIGINS=                  # comma-separated, contoh: https://zenthra.web.id (kosongkan hanya saat dev lokal)
